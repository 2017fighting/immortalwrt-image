# 钉点 —— 配方构建对象的唯一版本声明（ADR-0001：钉动则配方动）
# 升级上游 = 改 IMMORTALWRT_TAG + TOOLCHAIN_*（两者必须同 tag 配套，sha256 取自
# https://downloads.immortalwrt.org/releases/<版本>/targets/x86/64/sha256sums）
# 仓厏存 https 形式（CI 的 actions/checkout 与本地 clone 通用；SSH URL 在
# runner 上无 deploy key 不可用）

IMMORTALWRT_REPO=https://github.com/immortalwrt/immortalwrt.git
IMMORTALWRT_TAG=v25.12.1

TOOLCHAIN_URL=https://downloads.immortalwrt.org/releases/25.12.1/targets/x86/64/immortalwrt-toolchain-25.12.1-x86-64_gcc-14.3.0_musl.Linux-x86_64.tar.zst
