# 钉点 —— 配方构建对象的唯一版本声明（ADR-0001：钉动则配方动）
# 升级上游 = 改 IMMORTALWRT_TAG + TOOLCHAIN_*（两者必须同 tag 配套，sha256 取自
# https://downloads.immortalwrt.org/releases/<版本>/targets/x86/64/sha256sums）
# 仓厏存 https 形式（CI 的 actions/checkout 与本地 clone 通用；SSH URL 在
# runner 上无 deploy key 不可用）

IMMORTALWRT_REPO=https://github.com/immortalwrt/immortalwrt.git
IMMORTALWRT_TAG=v25.12.2

TOOLCHAIN_URL=https://downloads.immortalwrt.org/releases/25.12.2/targets/x86/64/immortalwrt-toolchain-25.12.2-x86-64_gcc-14.3.0_musl.Linux-x86_64.tar.zst
TOOLCHAIN_SHA256=cdada915b08a5979af9386614224c36427d2ad5d4209e95ac5f92d7a78f3acef

# honk 引擎源码钉点（ADR-0004）。daeuniverse feed 仓库只含打包 Makefile，
# 源码树（含 rust-toolchain.toml 钉的 Rust 工具链、.github/ci/pins.env 钉的
# doona/bpf-linker 版本与哈希）由 build.sh 按此 tag 克隆到 feed 包的 ./src。
# 升级 honk = 改此 tag，并同步核对 daeuniverse feed 钉点 commit 的 Makefile
# 默认 HONK_GIT_TAG 是否仍等于它（Makefile 把该 tag 嵌进二进制版本）。
HONK_TAG=v0.1.0-beta.6

# 镜像里嵌入的出厂仓库（= CONFIG_VERSION_REPO，设备侧就是
# /etc/apk/repositories.d/distfeeds.list 每行的前缀）。版本段用 %V
# （= CONFIG_VERSION_NUMBER，由 FW_VERSION 给），升 IMMORTALWRT_TAG 时这一行不动。
#
# 为什么钉点写在这里、而不是 config/x86-64.seed：整个 CONFIG_VERSION_* 家族都在
# package/base-files/image-config.in 的 `if VERSIONOPT` 之下，而 VERSIONOPT 的 prompt
# 又被 `if IMAGEOPT` 藏着（x86 目标不 select 它）——kconfig 把这些符号当「不可见」
# 直接丢掉。写进 seed 会在 defconfig 后消失，然后存活审计整轮失败（2026-11-26 的
# run 45780826198 就是这么红的）；更早还静默丢过 FW_VERSION / FW_CODE（v25.12.1-r20
# 的 /etc/openwrt_release 里一直是上游的 r37978-…，不是配方修订号）。
# 所以这三行由 build.sh 在 `make defconfig` **之后**追加进 .config（make 把 .config
# 当文本读，kconfig 不再碰它），并由构建末尾的断言核对它真的落进了产物。
# 见 docs/adr/0008-apk-repository-list-in-image.md 的「修正」段。
VERSION_REPO="https://mirrors.vsean.net/openwrt/releases/%V"
