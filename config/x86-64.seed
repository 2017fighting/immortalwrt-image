# immortalwrt-image x86_64 软路由 seed（diffconfig 最小集）
#
# 用法：CI 里 `cat 本文件 > .config`，追加动态版本行，再 `make defconfig` 展开。
# 每一行都是配方意图；默认值（apk、LuCI、防火墙等 ImmortalWrt 出厂即有）不写。
# 来源：用户 .config（defconfig 全展开版）人工折意图 + 会话决策；依赖链与
# ALL_KMODS 伪影不抄（依赖由 defconfig 自动解析）。
# 注意与 openwrt-feeds 侧官方包零同名冲突（已核实 immortalwrt openwrt-25.12
# feed 无 nikki/mihomo/natmapt 同名包）。

# ---- 目标：x86_64 通用软路由 ----
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---- 文件系统：squashfs（只读根 + overlay，恢复出厂/回滚安全）----
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# rootfs 分区 8192 MB（含 overlay）
CONFIG_TARGET_ROOTFS_PARTSIZE=8192

# ---- GRUB：零秒直启（要恢复启动菜单改回 "3"）----
CONFIG_GRUB_TIMEOUT="0"

# ---- DNS/DHCP：dnsmasq-full 全特性 ----
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

# ---- QoS / 流控（cake）----
# 注意：不要选 ip-tiny —— nikki/mihomo-alpha 硬依赖 ip-full，两者都提供
# 虚拟包 ip，apk 拒绝共存（r4 事故）；tc-tiny 无此冲突
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_tc-tiny=y

# ---- 穿透与证书 ----
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-acme=y

# ---- LuCI 常用应用 ----
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-rclone=y
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui=y
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng=y

# ---- 监控统计（collectd）----
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-exec=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y
CONFIG_PACKAGE_collectd-mod-sqm=y
CONFIG_PACKAGE_lm-sensors=y

# ---- 磁盘与外设 ----
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ---- 网卡：Realtek 供应商驱动（2.5G 常见；其余 NIC 驱动为 x86_64 默认已含）----
CONFIG_PACKAGE_kmod-r8101=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-r8168=y

# ---- 系统工具 ----
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_shellsync=y

# ---- LuCI 界面语言：简体中文 ----
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# ---- 内置：openwrt-feeds 全量（源码编译进镜像，出厂即有）----
CONFIG_PACKAGE_natmapt=y
CONFIG_PACKAGE_luci-app-natmapt=y
CONFIG_PACKAGE_stuntman-client=y
# natmapt 子包全量（通知：telegram/pushbullet/pushover；下载器联动：transmission/deluge）
CONFIG_PACKAGE_natmapt-notify-script-telegram=y
CONFIG_PACKAGE_natmapt-notify-script-pushbullet=y
CONFIG_PACKAGE_natmapt-notify-script-pushover=y
CONFIG_PACKAGE_natmapt-client-script-transmission=y
CONFIG_PACKAGE_natmapt-client-script-deluge=y

# ---- 内置：nikki 三件套（经桥 feed，Makefile 在 2017fighting/OpenWrt-nikki）----
CONFIG_PACKAGE_mihomo-alpha=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y

# ---- 明确不要 ----
# docker、passwall 不内置；ALL_KMODS / ALL_NONSHARED 不启用（原 .config 有：
# 只加全仓库 kmod 编译时间，不改镜像内容，需要哪个 kmod 单独选）

